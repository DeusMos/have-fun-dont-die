{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/post_edit_validation.py record",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/post_edit_validation.py stop",
        "timeout": 15,
        "loop_limit": 2
      }
    ]
  }
}
